# =============================================================================
# QUICKSTART CONFIG TEMPLATE
# =============================================================================
# Copy this file, rename it (e.g. configs/my_first_run.yml), and fill in
# the parts marked FILL IN. Then check it BEFORE training:
#
#     python scripts/validate_config.py --config configs/my_first_run.yml
#
# This runs a fast pre-flight check and tells you in plain language if
# anything's wrong -- much faster than discovering a typo partway through
# a real training run.
# =============================================================================

# ---------------------------------------------------------------------------
# WHERE YOUR DATA LIVES
# ---------------------------------------------------------------------------
# The folder containing all your variable subfolders (e.g. the output of
# convert_grib_to_netcdf.py --split_by_day).
data_root: !env "${DOWNSCALING_DATA_ROOT}"   # FILL IN, or: export DOWNSCALING_DATA_ROOT=/your/path

# ---------------------------------------------------------------------------
# WHAT REGION TO TRAIN ON
# ---------------------------------------------------------------------------
# Just pick one of these three names -- no need to look up coordinates:
#   region: africa
#   region: west_africa
#   region: ghana
#
# (If you ever need a custom area instead of one of these three, replace
# the line above with:
#   region:
#     lat_min: 4.5
#     lat_max: 11.5
#     lon_min: -3.5
#     lon_max: 1.5
# )
region: ghana

# ---------------------------------------------------------------------------
# PREDICTOR VARIABLES (the model's INPUT)
# ---------------------------------------------------------------------------
# One entry per variable. To add a new variable later, just copy one of
# these blocks and change name/path/normalisation -- nothing else in the
# whole codebase needs to change.
#
#   name           -- must match the variable name inside the .nc file
#   path            -- folder under data_root where this variable's files live
#   levels          -- ONLY needed for multi-level (pressure-level) variables,
#                       e.g. wind at multiple heights. Omit entirely for
#                       single-level variables like temperature.
#   resolution_deg  -- OPTIONAL. If your variables come from different
#                       sources at different native resolutions, set this
#                       to force them all onto the same grid. If omitted,
#                       the variable keeps whatever resolution is in its file.
#   normalisation   -- how to rescale this variable before feeding it to the
#                       model. "zscore" (mean/std) works for most physical
#                       variables (temperature, wind, pressure). "log1p" is
#                       better for skewed variables like precipitation. The
#                       mean/std values below are PLACEHOLDERS -- replace
#                       with real statistics computed from your own data.
inputs:
  - name: mx2t6                        # FILL IN: your variable's name
    path: D2m_T2m_CAPE_TCW/mx2t6         # FILL IN: its folder
    normalisation:
      type: zscore
      stats: {mean: 300.0, std: 8.0}     # FILL IN: real stats, this is a placeholder

  # Add more variables by copying the block above, e.g.:
  # - name: u
  #   path: U_V_700_500/u
  #   levels: [700, 500]
  #   normalisation:
  #     type: zscore
  #     stats: {mean: 0.0, std: 10.0}

# ---------------------------------------------------------------------------
# TARGET (what the model is trying to predict)
# ---------------------------------------------------------------------------
target:
  name: precip                          # FILL IN
  path: chirps_v3                        # FILL IN
  normalisation:
    type: log1p
    stats: {log1p_mean: 0.08, log1p_std: 0.27}   # FILL IN: real stats

# ---------------------------------------------------------------------------
# ADDITIONAL DATA (extra context channels)
# ---------------------------------------------------------------------------
# Two kinds:
#   - COMPUTED (no file needed): "day_of_year", "latlon" -- just list the
#     name, nothing else to configure.
#   - FILE-BACKED (needs a path): anything else, e.g. "elevation",
#     "land_mask" -- list the name here AND add its path below.
additional_data:
  - elevation
  - land_mask
  - latlon
  - day_of_year

additional_data_paths:
  elevation: static/elevation.nc         # FILL IN
  land_mask: static/landmask.nc          # FILL IN

# ---------------------------------------------------------------------------
# LEAD TIME (only relevant for forecast data like IFS/S2S, not ERA5)
# ---------------------------------------------------------------------------
# The longest lead time in your data, in days. Used to normalize lead time
# for the model. If training on ERA5 (no forecast lead time), set this to 1.0.
max_lead_days: 46.0
